# Committed on purpose — every value here is NEXT_PUBLIC_*, meaning it's
# bundled straight into client-side JS and was never a secret. This exists
# so any build that doesn't have .env.local (e.g. Cloudflare's git-connected
# build) still points at the real backend instead of localhost.
NEXT_PUBLIC_API_URL=https://api.exofe.com
NEXT_PUBLIC_APP_URL=https://app.exofe.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=758285437153-0pccrd6rkjrotehtb1am4pnvsob0moj7.apps.googleusercontent.com
NEXT_PUBLIC_META_APP_ID=2046960352567383
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=2888477578166240
